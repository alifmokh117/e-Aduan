    <!-- SCRIPT GABUNGAN (Public Form + Dashboard Logic) -->
    <script>
        // API URLs
        const GOOGLE_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbz8WZO6eFYBOwlP1uHNK9mLTop7G7S9VHcg5OTtyDtqx7UUkHFXWy42DpuhvwuFRlzHUQ/exec';
        const CSV_URL = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vRNtclPQ_ZQi1QYYBldwbbdoRLWjtsUrImRqsllf8VhxT9UidRqyHA6t6A2ouZRluW3z0Fd50jd7LxR/pub?output=csv';

        // --- SISTEM TOGGLE VIEW (SPA Logic) ---
        const mainBody = document.getElementById('mainBody');
        const publicView = document.getElementById('publicView');
        const adminView = document.getElementById('adminView');

        function switchToAdminView() {
            publicView.classList.add('opacity-0');
            setTimeout(() => {
                publicView.classList.add('hidden-view');
                adminView.classList.remove('hidden-view');
                // Tukar class Body untuk Dashboard style
                mainBody.className = 'bg-dash-light relative text-slate-800 dark:text-slate-100 flex flex-col min-h-screen transition-colors duration-500';
                setTimeout(() => adminView.classList.remove('opacity-0'), 50);
                
                // Load Dashboard Data only when accessed
                if(globalData.length === 0) fetchAndProcessData();
            }, 300);
        }

        function switchToPublicView() {
            adminView.classList.add('opacity-0');
            setTimeout(() => {
                adminView.classList.add('hidden-view');
                publicView.classList.remove('hidden-view');
                // Tukar class Body kembali ke Public style
                mainBody.className = 'bg-public-theme relative text-slate-100 flex flex-col min-h-screen transition-colors duration-500';
                setTimeout(() => publicView.classList.remove('opacity-0'), 50);
            }, 300);
        }

        // --- ADMIN LOGIN LOGIC ---
        const adminModal = document.getElementById('adminModal');
        const adminIdInput = document.getElementById('adminId');
        const adminPwdInput = document.getElementById('adminPwd');
        const adminErrorMsg = document.getElementById('adminErrorMsg');
        const btnSubmitAdmin = document.getElementById('btnSubmitAdmin');

        document.getElementById('btnAdminLogin').addEventListener('click', () => {
            adminIdInput.value = ''; adminPwdInput.value = ''; adminErrorMsg.classList.add('hidden');
            adminIdInput.classList.remove('border-rose-500', 'bg-rose-500/20');
            adminPwdInput.classList.remove('border-rose-500', 'bg-rose-500/20');
            openModal(adminModal);
        });
        document.getElementById('btnCloseAdmin').addEventListener('click', () => closeModal(adminModal));
        
        btnSubmitAdmin.addEventListener('click', () => {
            const id = adminIdInput.value.trim(), pwd = adminPwdInput.value.trim();
            if (id === 'admin' && pwd === '1234') {
                btnSubmitAdmin.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Memuatkan...';
                setTimeout(() => {
                    closeModal(adminModal);
                    btnSubmitAdmin.innerHTML = '<span>Akses Papan Pemuka</span><i class="fa-solid fa-arrow-right-to-bracket"></i>';
                    switchToAdminView();
                    showToast('Log Masuk Berjaya', 'Selamat Datang ke Dashboard Analitik.', 'success');
                }, 800);
            } else {
                adminErrorMsg.classList.remove('hidden');
                adminIdInput.classList.add('border-rose-500', 'bg-rose-500/20');
                adminPwdInput.classList.add('border-rose-500', 'bg-rose-500/20');
                const card = adminModal.querySelector('.glass-card');
                card.classList.add('translate-x-2');
                setTimeout(() => card.classList.replace('translate-x-2', '-translate-x-2'), 100);
                setTimeout(() => card.classList.remove('-translate-x-2'), 200);
            }
        });

        document.getElementById('btnLogout').addEventListener('click', () => {
            switchToPublicView();
            showToast('Log Keluar', 'Berjaya kembali ke Portal Awam.', 'info');
        });

        // --- PUBLIC FORM LOGIC (E-Aduan) ---
        const form = document.getElementById('formAduan'), inNama = document.getElementById('nama'),
              inTel = document.getElementById('telefon'), inEmail = document.getElementById('email'),
              inJenis = document.getElementById('jenisAduan'), inKeterangan = document.getElementById('keterangan');
        let currentUploadedFile = null;

        // Character counter
        document.getElementById('keterangan').addEventListener('input', function() {
            const len = this.value.length, cc = document.getElementById('charCounter');
            cc.textContent = `${len} / 600 aksara`;
            cc.className = len >= 550 ? 'text-[11px] font-mono text-rose-400' : 'text-[11px] font-mono text-slate-400';
        });

        // File upload
        document.getElementById('fileUpload').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (!file) return;
            if (file.size > 5 * 1024 * 1024) { showToast('Saiz Fail Besar', 'Maksimum 5MB.', 'error'); this.value = ''; return; }
            currentUploadedFile = file;
            document.getElementById('fileName').textContent = file.name;
            document.getElementById('fileSize').textContent = (file.size / (1024*1024)).toFixed(2) + ' MB';
            const imgThumb = document.getElementById('imageThumbnail'), pdfIco = document.getElementById('pdfIcon');
            if (file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = e => { imgThumb.src = e.target.result; imgThumb.classList.remove('hidden'); pdfIco.classList.add('hidden'); };
                reader.readAsDataURL(file);
            } else { imgThumb.classList.add('hidden'); pdfIco.classList.remove('hidden'); }
            document.getElementById('filePreviewContainer').classList.replace('hidden', 'flex');
        });
        document.getElementById('btnRemoveFile').addEventListener('click', () => {
            currentUploadedFile = null; document.getElementById('fileUpload').value = '';
            document.getElementById('filePreviewContainer').classList.replace('flex', 'hidden');
        });

        // Validation Helper
        function setFieldStatus(inputElement, isValid, errorText = '') {
            let parent = inputElement.parentElement;
            let errorSpan = null;
            while (parent && parent !== form) {
                errorSpan = parent.querySelector('.error-msg');
                if (errorSpan) break;
                parent = parent.parentElement;
            }
            if (!isValid) {
                inputElement.classList.add('border-rose-500', 'bg-rose-500/10');
                if (errorSpan) { errorSpan.textContent = errorText; errorSpan.classList.remove('hidden'); }
            } else {
                inputElement.classList.remove('border-rose-500', 'bg-rose-500/10');
                if (errorSpan) errorSpan.classList.add('hidden');
            }
        }
        [inNama, inTel, inEmail, inJenis, inKeterangan].forEach(input => input.addEventListener('input', () => setFieldStatus(input, true)));

        function validateForm() {
            let valid = true;
            if (inNama.value.trim().length < 3) { setFieldStatus(inNama, false, 'Sila masukkan nama penuh.'); valid = false; }
            if (!/^(\+?60|0)[1-9][0-9]{7,9}$/.test(inTel.value.replace(/[-\s]/g, ''))) { setFieldStatus(inTel, false, 'No telefon tidak sah.'); valid = false; }
            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(inEmail.value.trim())) { setFieldStatus(inEmail, false, 'E-mel tidak sah.'); valid = false; }
            if (!inJenis.value) { setFieldStatus(inJenis, false, 'Pilih kategori.'); valid = false; }
            if (inKeterangan.value.trim().length < 15) { setFieldStatus(inKeterangan, false, 'Huraian terlalu pendek.'); valid = false; }
            return valid;
        }

        const previewModal = document.getElementById('previewModal');
        document.getElementById('btnOpenPreview').addEventListener('click', () => {
            if (!validateForm()) return showToast('Tidak Lengkap', 'Perbetulkan ralat borang.', 'error');
            document.getElementById('prevNama').textContent = inNama.value.trim();
            document.getElementById('prevTel').textContent = inTel.value.trim();
            document.getElementById('prevEmail').textContent = inEmail.value.trim();
            document.getElementById('prevKategoriBadge').textContent = inJenis.options[inJenis.selectedIndex].text;
            
            const urg = document.querySelector('input[name="keutamaan"]:checked').value;
            const b = document.getElementById('prevKeutamaanBadge');
            b.textContent = urg;
            b.className = urg === 'Kritikal' ? 'px-2.5 py-1 rounded-lg bg-rose-500/20 text-rose-300 font-semibold border border-rose-500/30' :
                          (urg === 'Sederhana' ? 'px-2.5 py-1 rounded-lg bg-amber-500/20 text-amber-300 font-semibold border border-amber-500/30' : 
                                                 'px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 font-semibold border border-emerald-500/30');
            document.getElementById('prevKeterangan').textContent = inKeterangan.value.trim();
            const attRow = document.getElementById('prevAttachmentRow');
            if (currentUploadedFile) { document.getElementById('prevAttachmentName').textContent = currentUploadedFile.name; attRow.classList.replace('hidden', 'flex'); } 
            else attRow.classList.replace('flex', 'hidden');
            openModal(previewModal);
        });

        document.getElementById('btnClosePreview').addEventListener('click', () => closeModal(previewModal));
        document.getElementById('btnEditKembali').addEventListener('click', () => closeModal(previewModal));

        const btnSahkanHantar = document.getElementById('btnSahkanHantar');
        btnSahkanHantar.addEventListener('click', async () => {
            if (!GOOGLE_SCRIPT_URL.endsWith('/exec')) {
                showToast('Konfigurasi Ralat', 'URL Google Script mesti berakhir dengan /exec', 'error'); closeModal(previewModal); return;
            }
            const origHtml = btnSahkanHantar.innerHTML;
            btnSahkanHantar.disabled = true; btnSahkanHantar.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Menghantar...';

            const ticketId = `ADU-${new Date().getFullYear()}-${Math.floor(1000+Math.random()*9000)}`;
            const payload = {
                ticketId: ticketId, nama: inNama.value.trim(), telefon: inTel.value.trim(), email: inEmail.value.trim(),
                jenis: inJenis.value, keutamaan: document.querySelector('input[name="keutamaan"]:checked').value,
                keterangan: inKeterangan.value.trim(), notifyEmail: document.getElementById('notifyEmail').checked?'Ya':'Tidak',
                notifySMS: document.getElementById('notifySMS').checked?'Ya':'Tidak', fileName: currentUploadedFile?currentUploadedFile.name:'Tiada Lampiran'
            };

            try {
                const res = await fetch(GOOGLE_SCRIPT_URL, { method: 'POST', headers:{'Content-Type':'text/plain;charset=utf-8'}, body: JSON.stringify(payload) });
                const text = await res.text();
                if(text.includes('<!DOCTYPE')) throw new Error("Ralat Authorization Google. Sila benarkan MailApp dan deploy semula 'Anyone'.");
                const result = JSON.parse(text);
                
                if (result.status === 'success') {
                    document.getElementById('ticketNumber').textContent = ticketId;
                    closeModal(previewModal); openModal(document.getElementById('successModal'));
                    showToast('Berjaya!', 'Aduan dihantar dan PDF di-emel.', 'success');
                } else throw new Error(result.message);
            } catch (err) {
                showToast('Ralat Sistem', err.message, 'error');
            } finally { btnSahkanHantar.disabled = false; btnSahkanHantar.innerHTML = origHtml; }
        });

        document.getElementById('btnCopyTicket').addEventListener('click', function() {
            const btn = this; navigator.clipboard.writeText(document.getElementById('ticketNumber').textContent);
            btn.innerHTML = '<i class="fa-solid fa-check text-emerald-400"></i> Disalin!';
            setTimeout(() => btn.innerHTML = '<i class="fa-regular fa-copy"></i> Salin', 2000);
        });

        document.getElementById('btnDone').addEventListener('click', () => { closeModal(document.getElementById('successModal')); resetAll(); });
        document.getElementById('btnResetForm').addEventListener('click', () => { resetAll(); showToast('Dikosongkan', 'Borang diset semula.', 'info'); });

        function resetAll() {
            form.reset(); currentUploadedFile = null; document.getElementById('filePreviewContainer').classList.replace('flex', 'hidden');
            document.getElementById('charCounter').textContent = '0 / 600 aksara'; document.getElementById('charCounter').className = 'text-[11px] font-mono text-slate-400';
            [inNama, inTel, inEmail, inJenis, inKeterangan].forEach(i => setFieldStatus(i, true));
        }

        // --- DASHBOARD LOGIC ---
        let globalData = [], charts = {};
        
        const htmlElement = document.documentElement;
        if(localStorage.getItem('theme') === 'light') htmlElement.classList.remove('dark');
        
        document.getElementById('themeToggle').addEventListener('click', () => {
            htmlElement.classList.toggle('dark');
            localStorage.setItem('theme', htmlElement.classList.contains('dark') ? 'dark' : 'light');
            if(charts.category) updateChartColors();
        });

        async function fetchAndProcessData() {
            const icon = document.getElementById('refreshIcon');
            if(icon) icon.classList.add('fa-spin');
            
            Papa.parse(CSV_URL, {
                download: true, header: true, skipEmptyLines: true,
                complete: function(res) {
                    globalData = res.data.filter(row => row['Timestamp'] || row['No. Tiket']).reverse();
                    updateDashboard(globalData);
                    if(icon) icon.classList.remove('fa-spin');
                },
                error: function(err) {
                    document.getElementById('tableBody').innerHTML = `<tr><td colspan="6" class="px-6 py-10 text-center text-rose-500"><i class="fa-solid fa-triangle-exclamation text-3xl mb-3"></i><p>Ralat memuat turun CSV.</p></td></tr>`;
                    if(icon) icon.classList.remove('fa-spin');
                }
            });
        }
        document.getElementById('btnRefresh').addEventListener('click', fetchAndProcessData);

        function updateDashboard(data) {
            let total = data.length, crit = 0, mod = 0, norm = 0, catCounts = {}, prioCounts = {};
            data.forEach(r => {
                const prio = (r['Keutamaan']||'').trim().toLowerCase();
                if(prio==='kritikal') crit++; else if(prio==='sederhana') mod++; else norm++;
                const cat = (r['Kategori Aduan']||'Lain-lain').trim();
                catCounts[cat] = (catCounts[cat]||0)+1;
                const cPrio = prio.charAt(0).toUpperCase() + prio.slice(1) || 'Biasa';
                prioCounts[cPrio] = (prioCounts[cPrio]||0)+1;
            });
            animateValue("kpiTotal",0,total,1000); animateValue("kpiCritical",0,crit,1000);
            animateValue("kpiModerate",0,mod,1000); animateValue("kpiNormal",0,norm,1000);
            renderCharts(catCounts, prioCounts); renderTable(data);
        }

        function renderTable(data) {
            const tbody = document.getElementById('tableBody'); tbody.innerHTML = '';
            if(data.length === 0) { tbody.innerHTML = `<tr><td colspan="6" class="px-6 py-8 text-center">Tiada rekod.</td></tr>`; return; }
            
            const display = data.slice(0, 50);
            display.forEach(r => {
                let dStr = r['Timestamp']||'-';
                if(dStr!=='-'){ try{ const d=new Date(dStr); if(!isNaN(d)) dStr=`${d.toLocaleDateString('ms-MY',{day:'2-digit',month:'short',year:'numeric'})}<br><span class="text-[10px] text-slate-400">${d.toLocaleTimeString('ms-MY',{hour:'2-digit',minute:'2-digit'})}</span>`; }catch(e){} }
                
                const prio = (r['Keutamaan']||'Biasa').trim().toLowerCase();
                let bClass = 'bg-emerald-50 text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400 border-emerald-200 dark:border-emerald-500/20';
                if(prio==='kritikal') bClass = 'bg-rose-50 text-rose-600 dark:bg-rose-500/10 dark:text-rose-400 border-rose-200 dark:border-rose-500/20';
                else if(prio==='sederhana') bClass = 'bg-amber-50 text-amber-600 dark:bg-amber-500/10 dark:text-amber-400 border-amber-200 dark:border-amber-500/20';

                const rawAttach = r['Fail Lampiran'];
                const hasAttach = rawAttach && rawAttach!=='-' && rawAttach!=='Tiada Lampiran' && rawAttach.trim()!=='';
                const attachIco = hasAttach ? `<i class="fa-solid fa-paperclip text-blue-500 dark:text-blue-400 ml-2"></i>` : '';
                
                let cText = r['Kategori Aduan']||'-'; if(cText.length>30) cText=cText.substring(0,30)+'...';
                
                tbody.innerHTML += `<tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors group">
                    <td class="px-6 py-4 border-b border-slate-200 dark:border-slate-700/50 align-top">${dStr}</td>
                    <td class="px-6 py-4 border-b border-slate-200 dark:border-slate-700/50 align-top font-mono font-bold text-blue-600 dark:text-blue-400">${r['No. Tiket']||'-'}</td>
                    <td class="px-6 py-4 border-b border-slate-200 dark:border-slate-700/50 align-top"><div class="font-semibold text-slate-900 dark:text-white">${r['Nama Penuh']||'-'}</div><div class="text-[11px] text-slate-500">${r['No. Telefon']||'-'}</div></td>
                    <td class="px-6 py-4 border-b border-slate-200 dark:border-slate-700/50 align-top max-w-[200px] truncate" title="${r['Kategori Aduan']}">${cText} ${attachIco}</td>
                    <td class="px-6 py-4 border-b border-slate-200 dark:border-slate-700/50 align-top"><span class="inline-flex px-2.5 py-0.5 rounded-full text-[10px] font-bold border uppercase tracking-wide ${bClass}">${prio}</span></td>
                    <td class="px-6 py-4 border-b border-slate-200 dark:border-slate-700/50 align-top text-center flex items-center justify-center gap-2">
                        <button class="text-slate-400 hover:text-blue-600 p-1.5 rounded hover:bg-blue-50 dark:hover:bg-blue-900/30 transition"><i class="fa-solid fa-eye"></i></button>
                        ${hasAttach ? `<button class="text-slate-400 hover:text-purple-600 p-1.5 rounded hover:bg-purple-50 dark:hover:bg-purple-900/30 transition"><i class="fa-solid fa-file-arrow-down"></i></button>`:''}
                    </td></tr>`;
            });
            document.getElementById('tableInfo').innerText = `Memaparkan ${display.length} dari ${data.length} rekod.`;
        }

        document.getElementById('searchTable').addEventListener('input', e => {
            const term = e.target.value.toLowerCase();
            renderTable(globalData.filter(r => (r['No. Tiket']||'').toLowerCase().includes(term) || (r['Nama Penuh']||'').toLowerCase().includes(term)));
        });

        function renderCharts(catData, prioData) {
            Chart.defaults.font.family = "'Plus Jakarta Sans', sans-serif";
            const isDark = htmlElement.classList.contains('dark');
            Chart.defaults.color = isDark ? '#94a3b8' : '#64748b';
            
            const ctxCat = document.getElementById('categoryChart').getContext('2d');
            if(charts.category) charts.category.destroy();
            charts.category = new Chart(ctxCat, {
                type: 'doughnut', data: { labels: Object.keys(catData), datasets: [{ data: Object.values(catData), backgroundColor: ['#3b82f6','#8b5cf6','#10b981','#f59e0b','#ef4444','#06b6d4'], borderWidth: isDark?2:1, borderColor: isDark?'#1e293b':'#ffffff' }] },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'right' } }, cutout: '65%' }
            });

            const ctxPrio = document.getElementById('priorityChart').getContext('2d');
            if(charts.priority) charts.priority.destroy();
            const order = ['Kritikal','Sederhana','Biasa'];
            charts.priority = new Chart(ctxPrio, {
                type: 'bar', data: { labels: order, datasets: [{ label: 'Bilangan Aduan', data: order.map(p=>prioData[p]||0), backgroundColor: ['rgba(244,63,94,0.8)','rgba(245,158,11,0.8)','rgba(16,185,129,0.8)'], borderRadius: 6 }] },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, grid: { color: isDark?'rgba(255,255,255,0.05)':'rgba(0,0,0,0.05)' } }, x: { grid: { display: false } } } }
            });
        }

        function updateChartColors() {
            const isDark = htmlElement.classList.contains('dark');
            Chart.defaults.color = isDark ? '#94a3b8' : '#64748b';
            if(charts.category) { charts.category.data.datasets[0].borderColor = isDark ? '#1e293b' : '#ffffff'; charts.category.update(); }
            if(charts.priority) { charts.priority.options.scales.y.grid.color = isDark ? 'rgba(255, 255, 255, 0.05)' : 'rgba(0, 0, 0, 0.05)'; charts.priority.update(); }
        }

        function animateValue(id, start, end, dur) {
            const obj = document.getElementById(id); if(!obj) return;
            if(end===0){ obj.innerHTML="0"; return; }
            let startT = null;
            const step = (t) => {
                if(!startT) startT = t;
                const p = Math.min((t-startT)/dur, 1), e = 1-Math.pow(1-p, 4);
                obj.innerHTML = Math.floor(e*(end-start)+start);
                if(p<1) requestAnimationFrame(step); else obj.innerHTML = end;
            }; requestAnimationFrame(step);
        }

        // --- GLOBAL UI HELPERS ---
        let toastTimeout;
        function showToast(title, msg, type='info') {
            const t = document.getElementById('toast'), tTitle = document.getElementById('toastTitle'), tBody = document.getElementById('toastBody'), tIcon = document.getElementById('toastIcon');
            tTitle.textContent = title; tBody.textContent = msg;
            if (type === 'error') { t.className = 'fixed bottom-5 right-5 z-[70] glass-card border-l-4 border-rose-500 px-5 py-3.5 rounded-2xl shadow-2xl flex items-center gap-3 transform transition-all duration-300'; tIcon.className = 'text-rose-400 text-base'; tIcon.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i>'; }
            else if (type === 'success') { t.className = 'fixed bottom-5 right-5 z-[70] glass-card border-l-4 border-emerald-400 px-5 py-3.5 rounded-2xl shadow-2xl flex items-center gap-3 transform transition-all duration-300 text-slate-100'; tIcon.className = 'text-emerald-400 text-base'; tIcon.innerHTML = '<i class="fa-solid fa-circle-check"></i>'; }
            else { t.className = 'fixed bottom-5 right-5 z-[70] glass-card border-l-4 border-blue-500 px-5 py-3.5 rounded-2xl shadow-2xl flex items-center gap-3 transform transition-all duration-300 text-slate-100'; tIcon.className = 'text-blue-400 text-base'; tIcon.innerHTML = '<i class="fa-solid fa-circle-info"></i>'; }
            t.classList.remove('translate-y-24', 'opacity-0');
            clearTimeout(toastTimeout); toastTimeout = setTimeout(() => t.classList.add('translate-y-24', 'opacity-0'), 4000);
        }
        function openModal(m) { m.classList.remove('opacity-0', 'pointer-events-none'); const i = m.querySelector('div'); if(i) i.classList.replace('scale-95', 'scale-100'); }
        function closeModal(m) { m.classList.add('opacity-0', 'pointer-events-none'); const i = m.querySelector('div'); if(i) i.classList.replace('scale-100', 'scale-95'); }
    </script>
</body>
</html>
