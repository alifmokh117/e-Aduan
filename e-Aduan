<!DOCTYPE html>
<html lang="ms" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem E-Aduan Pintar & Dashboard Analitik</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Tailwind Configuration for Dark Mode & Custom Colors -->
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: { sans: ['Plus Jakarta Sans', 'Inter', 'sans-serif'] },
                    colors: {
                        glass: { light: 'rgba(255, 255, 255, 0.7)', dark: 'rgba(15, 23, 42, 0.6)' },
                        glassBorder: { light: 'rgba(255, 255, 255, 0.4)', dark: 'rgba(255, 255, 255, 0.1)' }
                    }
                }
            }
        }
    </script>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Chart.js & PapaParse (Untuk Dashboard) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>

    <style>
        * { font-family: 'Plus Jakarta Sans', sans-serif; }

        /* Latar Belakang Borang Awam (Public) */
        .bg-public-theme {
            background-color: #090d16;
            background-image: 
                radial-gradient(at 0% 0%, rgba(59, 130, 246, 0.22) 0px, transparent 50%),
                radial-gradient(at 100% 0%, rgba(147, 51, 234, 0.2) 0px, transparent 50%),
                radial-gradient(at 50% 100%, rgba(16, 185, 129, 0.15) 0px, transparent 50%);
            min-height: 100vh;
        }

        /* Latar Belakang Dashboard (Light/Dark) */
        .bg-dash-light {
            background-color: #f1f5f9;
            background-image: 
                radial-gradient(at 0% 0%, rgba(59, 130, 246, 0.15) 0px, transparent 50%),
                radial-gradient(at 100% 0%, rgba(147, 51, 234, 0.1) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(16, 185, 129, 0.1) 0px, transparent 50%);
            background-attachment: fixed;
        }
        .dark .bg-dash-light {
            background-color: #090d16;
            background-image: 
                radial-gradient(at 0% 0%, rgba(59, 130, 246, 0.22) 0px, transparent 50%),
                radial-gradient(at 100% 0%, rgba(147, 51, 234, 0.2) 0px, transparent 50%),
                radial-gradient(at 50% 100%, rgba(16, 185, 129, 0.15) 0px, transparent 50%);
            background-attachment: fixed;
        }

        /* Elemen Kaca (Glassmorphism) Awam */
        .glass-card {
            background: rgba(18, 25, 43, 0.72);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.1);
        }
        .glass-panel-sub { background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08); backdrop-filter: blur(10px); }
        
        .glass-input {
            background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.15); color: #f8fafc;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .glass-input:focus { background: rgba(30, 41, 59, 0.8); border-color: #60a5fa; box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.25); outline: none; }
        .glass-input::placeholder { color: rgba(148, 163, 184, 0.6); }

        /* Elemen Kaca (Glassmorphism) Dashboard */
        .dash-glass-panel { backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); transition: all 0.3s ease-in-out; }

        /* Animasi Orbs Awam */
        .ambient-orb {
            position: fixed; border-radius: 50%; filter: blur(90px); z-index: 0; pointer-events: none; opacity: 0.45;
            animation: pulseOrb 12s ease-in-out infinite alternate;
        }
        @keyframes pulseOrb {
            0% { transform: scale(1) translate(0px, 0px); }
            50% { transform: scale(1.15) translate(25px, -20px); }
            100% { transform: scale(0.95) translate(-20px, 20px); }
        }

        /* Custom Dropdown Option Fix */
        select option { background-color: #0f172a; color: #f1f5f9; padding: 10px; }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 7px; height: 7px; }
        ::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.6); border-radius: 4px;}
        .dark ::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.05); }
        ::-webkit-scrollbar-thumb { background: rgba(156, 163, 175, 0.5); border-radius: 9999px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(107, 114, 128, 0.8); }

        /* View Transition */
        .view-section { transition: opacity 0.5s ease-in-out; }
        .hidden-view { display: none !important; opacity: 0; }
    </style>
</head>
<body id="mainBody" class="bg-public-theme relative text-slate-100 flex flex-col min-h-screen transition-colors duration-500">

    <!-- ============================================== -->
    <!-- PANDANGAN AWAM: BORANG E-ADUAN                 -->
    <!-- ============================================== -->
    <div id="publicView" class="view-section flex flex-col justify-between py-6 px-4 sm:px-6 lg:px-8 w-full h-full flex-grow relative">
        
        <!-- Ambient Glowing Background Elements -->
        <div class="ambient-orb w-96 h-96 bg-blue-600 top-[-5%] left-[-5%]"></div>
        <div class="ambient-orb w-[28rem] h-[28rem] bg-purple-600 top-[35%] right-[-10%]" style="animation-delay: -4s;"></div>
        <div class="ambient-orb w-96 h-96 bg-emerald-600 bottom-[-10%] left-[25%]" style="animation-delay: -8s;"></div>

        <!-- Butang Akses Admin -->
        <div class="absolute top-4 right-4 sm:top-6 sm:right-6 z-40">
            <button id="btnAdminLogin" class="flex items-center gap-2 px-3.5 py-2 rounded-full glass-panel-sub hover:bg-white/10 text-slate-300 hover:text-white transition-all duration-300 text-[11px] font-semibold tracking-wide border border-white/10 shadow-lg shadow-black/20">
                <i class="fa-solid fa-user-shield"></i> <span class="hidden sm:inline">Portal Admin</span>
            </button>
        </div>

        <main class="relative z-10 max-w-4xl w-full mx-auto my-auto">
            <!-- Header Banner -->
            <header class="text-center mb-8 pt-8 sm:pt-0">
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass-panel-sub text-blue-400 text-xs font-semibold uppercase tracking-wider mb-3">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                    Talian Aduan & Maklum Balas Bersepadu
                </div>
                <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white mb-3">
                    Sistem <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-300 to-purple-400">E-Aduan Awam</span>
                </h1>
                <p class="text-slate-300 text-sm sm:text-base max-w-xl mx-auto">
                    Laporkan sebarang isu, kerosakan fasiliti, atau ketidakpuasan perkhidmatan dengan telus, pantas, dan bersistematik.
                </p>
            </header>

            <!-- Form Card -->
            <div class="glass-card rounded-3xl p-6 sm:p-10 transition-all duration-300 border border-white/10">
                <div class="flex items-center justify-between mb-8 pb-5 border-b border-white/10">
                    <div class="flex items-center space-x-3">
                        <div class="w-9 h-9 rounded-xl bg-blue-500/20 border border-blue-400/40 text-blue-400 flex items-center justify-center font-bold text-sm">1</div>
                        <div>
                            <h2 class="text-sm font-semibold text-white leading-none">Maklumat Pengadu & Aduan</h2>
                            <span class="text-xs text-slate-400">Sila isi medan bertanda (*) dengan teliti</span>
                        </div>
                    </div>
                    <span class="hidden sm:inline-flex items-center text-xs text-emerald-400 bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/20">
                        <i class="fa-solid fa-lock text-[10px] mr-1.5"></i> Data Disulitkan & Dilindungi
                    </span>
                </div>

                <form id="formAduan" novalidate class="space-y-6">
                    <!-- Seksyen 1 -->
                    <div class="space-y-4">
                        <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-2">
                            <i class="fa-solid fa-address-card text-blue-400"></i> Butiran Pemohon
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div class="space-y-1.5">
                                <label for="nama" class="block text-xs font-medium text-slate-200">Nama Penuh <span class="text-rose-400">*</span></label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-sm"><i class="fa-regular fa-user"></i></div>
                                    <input type="text" id="nama" placeholder="Contoh: Muhammad Harith" class="glass-input w-full pl-10 pr-4 py-3 rounded-xl text-sm" required>
                                </div>
                                <span class="error-msg text-[11px] text-rose-400 hidden">Nama penuh diperlukan.</span>
                            </div>
                            <div class="space-y-1.5">
                                <label for="telefon" class="block text-xs font-medium text-slate-200">No. Telefon Bimbit <span class="text-rose-400">*</span></label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-sm"><i class="fa-solid fa-phone"></i></div>
                                    <input type="tel" id="telefon" placeholder="Contoh: 012-3456789" class="glass-input w-full pl-10 pr-4 py-3 rounded-xl text-sm" required>
                                </div>
                                <span class="error-msg text-[11px] text-rose-400 hidden">No. telefon yang sah diperlukan.</span>
                            </div>
                            <div class="space-y-1.5 md:col-span-2">
                                <label for="email" class="block text-xs font-medium text-slate-200">Alamat E-mel Rasmi <span class="text-rose-400">*</span></label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-sm"><i class="fa-regular fa-envelope"></i></div>
                                    <input type="email" id="email" placeholder="nama@domain.com" class="glass-input w-full pl-10 pr-4 py-3 rounded-xl text-sm" required>
                                </div>
                                <span class="error-msg text-[11px] text-rose-400 hidden">Format e-mel tidak sah.</span>
                            </div>
                        </div>
                    </div>

                    <!-- Seksyen 2 -->
                    <div class="space-y-4 pt-4 border-t border-white/5">
                        <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-2">
                            <i class="fa-solid fa-clipboard-list text-purple-400"></i> Klasifikasi Isu
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div class="space-y-1.5">
                                <label for="jenisAduan" class="block text-xs font-medium text-slate-200">Jenis / Kategori Aduan <span class="text-rose-400">*</span></label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-sm"><i class="fa-solid fa-shapes"></i></div>
                                    <select id="jenisAduan" required class="glass-input w-full pl-10 pr-10 py-3 rounded-xl text-sm appearance-none cursor-pointer">
                                        <option value="" disabled selected>Pilih kategori masalah...</option>
                                        <option value="Infrastruktur & Kemudahan Awam">Infrastruktur & Kemudahan Awam (Jalan, Lampu, Paip)</option>
                                        <option value="Kualiti Perkhidmatan Kaunter/Kakitangan">Kualiti Perkhidmatan Kaunter / Layanan Kakitangan</option>
                                        <option value="Teknikal & Gangguan Sistem Online">Teknikal & Gangguan Portal / Sistem E-Perkhidmatan</option>
                                        <option value="Integriti & Tatatertib">Integriti, Rasuah & Salah Laku Pentadbiran</option>
                                        <option value="Keselamatan Awam & Kebersihan">Keselamatan Awam & Isu Kebersihan Persekitaran</option>
                                        <option value="Lain-lain Maklum Balas">Lain-lain Cadangan & Maklum Balas</option>
                                    </select>
                                    <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-slate-400 text-xs"><i class="fa-solid fa-chevron-down"></i></div>
                                </div>
                                <span class="error-msg text-[11px] text-rose-400 hidden">Sila pilih sekurang-kurangnya satu kategori.</span>
                            </div>
                            <div class="space-y-1.5">
                                <label for="tahapKeutamaan" class="block text-xs font-medium text-slate-200">Tahap Keutamaan (Urgency)</label>
                                <div class="grid grid-cols-3 gap-2">
                                    <label class="cursor-pointer">
                                        <input type="radio" name="keutamaan" value="Biasa" class="peer sr-only" checked>
                                        <div class="p-2.5 rounded-xl border border-white/10 peer-checked:border-emerald-500 peer-checked:bg-emerald-500/20 text-center transition"><p class="text-xs font-semibold text-slate-300 peer-checked:text-emerald-300">Biasa</p></div>
                                    </label>
                                    <label class="cursor-pointer">
                                        <input type="radio" name="keutamaan" value="Sederhana" class="peer sr-only">
                                        <div class="p-2.5 rounded-xl border border-white/10 peer-checked:border-amber-500 peer-checked:bg-amber-500/20 text-center transition"><p class="text-xs font-semibold text-slate-300 peer-checked:text-amber-300">Sederhana</p></div>
                                    </label>
                                    <label class="cursor-pointer">
                                        <input type="radio" name="keutamaan" value="Kritikal" class="peer sr-only">
                                        <div class="p-2.5 rounded-xl border border-white/10 peer-checked:border-rose-500 peer-checked:bg-rose-500/20 text-center transition"><p class="text-xs font-semibold text-slate-300 peer-checked:text-rose-300">Kritikal</p></div>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="space-y-1.5">
                            <div class="flex justify-between items-center">
                                <label for="keterangan" class="block text-xs font-medium text-slate-200">Perincian & Keterangan Aduan <span class="text-rose-400">*</span></label>
                                <span id="charCounter" class="text-[11px] text-slate-400 font-mono">0 / 600 aksara</span>
                            </div>
                            <textarea id="keterangan" rows="4" maxlength="600" required placeholder="Nyatakan lokasi spesifik, tarikh kejadian, no. rujukan berkaitan..." class="glass-input w-full p-4 rounded-xl text-sm leading-relaxed resize-none"></textarea>
                            <span class="error-msg text-[11px] text-rose-400 hidden">Sila berikan butiran sekurang-kurangnya 15 aksara.</span>
                        </div>

                        <!-- Muat Naik -->
                        <div class="space-y-2">
                            <label class="block text-xs font-medium text-slate-200">Lampiran Bukti Bergambar (Pilihan)</label>
                            <div id="dropZone" class="border-2 border-dashed border-white/15 rounded-2xl p-4 sm:p-6 text-center hover:border-blue-400/50 hover:bg-white/[0.02] transition-colors cursor-pointer relative group">
                                <input type="file" id="fileUpload" accept="image/*,.pdf" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full">
                                <div class="flex flex-col items-center justify-center space-y-2">
                                    <div class="w-12 h-12 rounded-full bg-blue-500/10 border border-blue-400/20 flex items-center justify-center text-blue-400 group-hover:scale-110 transition-transform"><i class="fa-solid fa-cloud-arrow-up text-lg"></i></div>
                                    <p class="text-xs font-medium text-slate-200">Klik atau seret fail ke sini (JPG, PNG, PDF maks. 5MB)</p>
                                </div>
                            </div>
                            <!-- Preview Fail -->
                            <div id="filePreviewContainer" class="hidden items-center justify-between glass-panel-sub p-3 rounded-xl border border-white/10 mt-2">
                                <div class="flex items-center space-x-3">
                                    <img id="imageThumbnail" class="w-10 h-10 rounded-lg object-cover border border-white/20 hidden" alt="Pratonton">
                                    <div id="pdfIcon" class="w-10 h-10 rounded-lg bg-rose-500/20 text-rose-400 flex items-center justify-center text-lg hidden"><i class="fa-solid fa-file-pdf"></i></div>
                                    <div>
                                        <p id="fileName" class="text-xs font-medium text-white max-w-[200px] truncate">fail.jpg</p>
                                        <p id="fileSize" class="text-[10px] text-slate-400">0 KB</p>
                                    </div>
                                </div>
                                <button type="button" id="btnRemoveFile" class="text-slate-400 hover:text-rose-400 p-2 text-sm transition"><i class="fa-solid fa-trash-can"></i></button>
                            </div>
                        </div>

                        <div class="pt-2">
                            <label class="block text-xs font-medium text-slate-300 mb-2">Saluran Kemas Kini Status Pilihan:</label>
                            <div class="flex flex-wrap gap-4 text-xs">
                                <label class="inline-flex items-center gap-2 cursor-pointer text-slate-300 hover:text-white">
                                    <input type="checkbox" id="notifyEmail" checked class="rounded bg-slate-900 border-white/20 text-blue-500 focus:ring-0"> <span>Notifikasi E-mel</span>
                                </label>
                                <label class="inline-flex items-center gap-2 cursor-pointer text-slate-300 hover:text-white">
                                    <input type="checkbox" id="notifySMS" class="rounded bg-slate-900 border-white/20 text-blue-500 focus:ring-0"> <span>SMS / WhatsApp Status</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Tindakan -->
                    <div class="pt-6 flex flex-col-reverse sm:flex-row gap-3 sm:items-center sm:justify-end border-t border-white/10">
                        <button type="button" id="btnResetForm" class="px-5 py-3 rounded-xl glass-panel-sub hover:bg-white/10 text-slate-300 hover:text-white font-medium text-xs tracking-wider transition-all duration-200"><i class="fa-solid fa-arrows-rotate mr-1.5"></i> Kosongkan</button>
                        <button type="button" id="btnOpenPreview" class="px-7 py-3 rounded-xl bg-gradient-to-r from-blue-500 via-indigo-600 to-purple-600 hover:from-blue-600 hover:to-purple-700 shadow-lg shadow-blue-500/25 text-white font-semibold text-xs tracking-wider uppercase transition-all duration-300 transform active:scale-95 flex items-center justify-center gap-2">
                            <span>Semak & Pratonton Aduan</span> <i class="fa-solid fa-arrow-right text-xs"></i>
                        </button>
                    </div>
                </form>
            </div>
            <footer class="mt-6 text-center text-xs text-slate-400"><p>Penyaluran maklumat dilindungi di bawah Akta Perlindungan Data Peribadi.</p></footer>
        </main>
    </div>

    <!-- ============================================== -->
    <!-- PANDANGAN ADMIN: DASHBOARD ANALITIK            -->
    <!-- ============================================== -->
    <div id="adminView" class="view-section hidden-view w-full min-h-screen text-slate-800 dark:text-slate-100 flex flex-col">
        <!-- Top Navigation -->
        <nav class="fixed top-0 w-full z-50 dash-glass-panel bg-glass-light border-b border-glassBorder-light dark:bg-glass-dark dark:border-glassBorder-dark">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex items-center justify-between h-16">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center text-white shadow-lg"><i class="fa-solid fa-chart-pie text-xl"></i></div>
                        <div>
                            <h1 class="text-lg font-bold tracking-tight text-slate-900 dark:text-white leading-tight">E-Aduan Analytics</h1>
                            <p class="text-[11px] text-slate-500 dark:text-slate-400 font-medium uppercase tracking-wider">Executive Dashboard</p>
                        </div>
                    </div>
                    
                    <div class="flex items-center gap-2 sm:gap-4">
                        <button id="btnRefresh" class="flex items-center gap-2 text-sm font-medium text-slate-600 hover:text-blue-600 dark:text-slate-300 dark:hover:text-blue-400 transition-colors px-3 py-2 rounded-lg hover:bg-slate-200/50 dark:hover:bg-slate-800/50">
                            <i class="fa-solid fa-rotate-right" id="refreshIcon"></i> <span class="hidden sm:inline">Segarkan Data</span>
                        </button>
                        
                        <button id="themeToggle" class="w-9 h-9 rounded-full flex items-center justify-center dash-glass-panel bg-white/50 border border-slate-200 text-slate-600 dark:bg-slate-800/50 dark:border-slate-700 dark:text-amber-300 hover:scale-110 transition-transform shadow-sm">
                            <i class="fa-solid fa-moon dark:hidden"></i>
                            <i class="fa-solid fa-sun hidden dark:block"></i>
                        </button>
                        
                        <!-- Butang Log Keluar (Tukar ke Public View) -->
                        <button id="btnLogout" class="flex items-center gap-2 text-xs font-semibold bg-rose-500/10 text-rose-600 hover:bg-rose-500/20 dark:bg-rose-500/20 dark:text-rose-400 dark:hover:bg-rose-500/30 transition-colors px-3 py-2 rounded-lg ml-2">
                            <i class="fa-solid fa-right-from-bracket"></i> <span class="hidden sm:inline">Log Keluar</span>
                        </button>
                    </div>
                </div>
            </div>
        </nav>

        <main class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-12 flex-grow">
            <!-- Header Info -->
            <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
                <div>
                    <h2 class="text-2xl font-extrabold text-slate-900 dark:text-white">Keseluruhan Projek & Operasi</h2>
                    <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Status masa nyata dari pangkalan data Google Sheets</p>
                </div>
                <div class="text-sm font-medium px-4 py-2 rounded-xl dash-glass-panel bg-white/60 border border-slate-200 dark:bg-slate-800/40 dark:border-slate-700/50 flex items-center gap-2 inline-flex w-fit">
                    <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div> Status Sistem: <span class="text-emerald-600 dark:text-emerald-400 font-bold">Aktif</span>
                </div>
            </div>

            <!-- KPI Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                <div class="dash-glass-panel bg-white/70 border border-slate-200 dark:bg-slate-800/60 dark:border-slate-700/50 rounded-2xl p-6 shadow-sm relative overflow-hidden group">
                    <div class="absolute -right-6 -top-6 text-blue-500/10 dark:text-blue-500/20 text-8xl group-hover:scale-110 transition-transform"><i class="fa-solid fa-users"></i></div>
                    <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">Jumlah Tiket Aduan</p>
                    <h3 class="text-4xl font-extrabold text-slate-900 dark:text-white" id="kpiTotal">-</h3>
                </div>
                <div class="dash-glass-panel bg-white/70 border border-slate-200 dark:bg-slate-800/60 dark:border-slate-700/50 rounded-2xl p-6 shadow-sm relative overflow-hidden group">
                    <div class="absolute -right-6 -top-6 text-rose-500/10 dark:text-rose-500/20 text-8xl group-hover:scale-110 transition-transform"><i class="fa-solid fa-triangle-exclamation"></i></div>
